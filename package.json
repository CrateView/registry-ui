{
  "name": "@crateview/registry-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "node scripts/patch-import-x.mjs && nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "predev": "npm run licenses:generate",
    "prebuild": "npm run licenses:generate",
    "test:monitoring:integration": "node tests/monitoring-integration.mjs",
    "test:auth": "npm --prefix auth test",
    "test:auth:integration": "node tests/accounts-integration.mjs",
    "test:auth:browser": "node tests/accounts-integration.mjs --browser"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "markdown-it": "^15.0.3",
    "nuxt": "4.6.3",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@nuxt/eslint": "^1.15.0",
    "@playwright/test": "^1.58.0",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^26.6.6",
    "bcryptjs": "^3.0.3",
    "deepmerge": "file:vendor/deepmerge",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.0"
  },
  "description": "A modern, themeable web UI for Docker and OCI container registries.",
  "homepage": "https://crateview.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crateview/registry-ui.git"
  },
  "bugs": {
    "url": "https://github.com/crateview/registry-ui/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/tobiaswaelde"
  },
  "version": "0.5.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "^14.0.3",
    "esbuild": "^0.28.2",
    "deepmerge": "$deepmerge"
  }
}
