# Released Docker image tag.
CRATEVIEW_VERSION=v0.1.0
NUXT_REGISTRY_UPSTREAM=http://127.0.0.1:5000
NUXT_REGISTRY_DELETE_ENABLED=false
# Generate a random 32-byte secret for persistent production sessions.
NUXT_SESSION_PASSWORD=
NUXT_PUBLIC_THEME_PRIMARY=red
NUXT_PUBLIC_THEME_NEUTRAL=zinc
NUXT_PUBLIC_THEME_RADIUS=0.5rem
NUXT_PUBLIC_THEME_FONT_FAMILY=Inter, ui-sans-serif, system-ui, sans-serif
NUXT_PUBLIC_BRAND_NAME=Crateview
NUXT_PUBLIC_BRAND_DESCRIPTION=A modern interface for Docker and OCI container registries.
NUXT_PUBLIC_BRAND_LOGO_LIGHT=/branding/crateview-mark-256.png
NUXT_PUBLIC_BRAND_LOGO_DARK=/branding/crateview-mark-256.png
NUXT_PUBLIC_BRAND_FAVICON=/favicon.ico
NUXT_PUBLIC_BRAND_TITLE_TEMPLATE=%s · Crateview
NUXT_PUBLIC_BRAND_PRODUCT_URL=https://crateview.de
NUXT_PUBLIC_BRAND_DOCS_URL=https://github.com/crateview/registry-ui#readme
NUXT_PUBLIC_BRAND_REPOSITORY_URL=https://github.com/crateview/registry-ui

# Optional Distribution monitoring. Enabling grants registry-wide data to all UI users.
NUXT_MONITORING_ENABLED=false
NUXT_MONITORING_METRICS_URL=
NUXT_MONITORING_METRICS_TOKEN=
NUXT_MONITORING_WEBHOOK_SECRET=
NUXT_MONITORING_DATABASE_PATH=.dev/monitoring.sqlite

# Optional independent account service: off | htpasswd | token.
NUXT_AUTH_MODE=off
NUXT_AUTH_SERVICE_URL=
NUXT_AUTH_SERVICE_SECRET=
# Exact public Bearer challenge realm; required only for managed token mode.
NUXT_AUTH_TOKEN_REALM=
# Empty: nobody; comma-separated usernames; *: every authenticated user.
NUXT_USER_CREATION_ALLOWED_USERS=
# Compose auth overlays:
AUTH_MANAGEMENT_SECRET=
AUTH_PUBLIC_URL=
AUTH_SERVICE=
AUTH_KEYS_DIR=./.dev/auth-keys
